# =============================================================================
# DJANGO ENVIRONMENT SETTINGS
# =============================================================================

# Environment: development | production
DJANGO_ENV=development

# Django secret key (generate new one for production!)
# You can generate it with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Timezone
TIME_ZONE=UTC

# Allowed hosts for production (comma-separated)
# Example: example.com,www.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# EMAIL SETTINGS (Gmail)
# =============================================================================
# For Gmail, you need to create an App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Factor Authentication
# 3. Go to App Passwords and create one for "Mail"

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Email where notifications will be sent
ADMIN_EMAIL=your-email@gmail.com

# From email for outgoing messages
DEFAULT_FROM_EMAIL=your-email@gmail.com

# =============================================================================
# TELEGRAM BOT SETTINGS
# =============================================================================
# Get your bot token from @BotFather
# Get your chat_id by messaging your bot and visiting:
# https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# =============================================================================
# SITE SETTINGS
# =============================================================================
SITE_NAME=Synterra

# =============================================================================
# DATABASE SETTINGS (for production with PostgreSQL)
# =============================================================================
# DB_NAME=company_site
# DB_USER=postgres
# DB_PASSWORD=your-db-password
# DB_HOST=localhost
# DB_PORT=5432
